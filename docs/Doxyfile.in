# snicholls-core - Doxygen configuration, configured by CMake into the build
# directory. Warnings are errors for everything, from the first header: there is
# no list of "not yet converted" modules here to shrink, because nothing is
# admitted unconverted (CLAUDE.md "Documentation").

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "snicholls-core"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Vocabulary types and compile-time reflection shared by the snicholls libraries"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@

INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/README.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/RESULT_PLAN.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/include
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/README.md

# \snippet pulls marked regions out of compiled demos, never hand-copied code
EXAMPLE_PATH           = @CMAKE_CURRENT_SOURCE_DIR@/demos
EXAMPLE_RECURSIVE      = YES

STRIP_FROM_PATH        = @CMAKE_CURRENT_SOURCE_DIR@/include
HTML_FOOTER            = @CMAKE_CURRENT_SOURCE_DIR@/docs/footer.html
STRIP_FROM_INC_PATH    = @CMAKE_CURRENT_SOURCE_DIR@/include
FULL_PATH_NAMES        = YES

# The section commands of the documentation standard (CLAUDE.md "Documentation"),
# shared across the snicholls libraries, so a header moving between them keeps
# its documentation word for word. Each renders as a titled paragraph.
ALIASES                = "overview=\par Overview^^" \
                         "relations=\par Relationships^^" \
                         "impls=\par Implementations and variants^^" \
                         "contracts=\par Guarantees and contracts^^" \
                         "errors=\par Errors^^" \
                         "examples=\par Examples^^" \
                         "perf=\par Performance^^" \
                         "testing=\par Tests and demos^^" \
                         "deps=\par Dependencies^^" \
                         "gotchas=\par Known issues and gotchas^^" \
                         "status=\par Status^^"

EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
EXCLUDE_SYMBOLS        = snicholls::detail snicholls::detail::* *::detail *::detail::* SNICHOLLS_DETAIL_* \
                         *::result_impl *::result_impl::* *::result_detail *::result_detail::* \
                         *::traced_detail *::traced_detail::* SNICHOLLS_RESULT_CAT* SNICHOLLS_RESULT_TRY_*

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
HAVE_DOT               = NO
MACRO_EXPANSION        = NO
# Seen by Doxygen only: result.hpp documents the throwing policy, and shows
# bad_result_access<E> deriving from std::logic_error (Doxygen reports the real
# base, its own <void> specialisation, as a recursive class relation).
PREDEFINED             = SNICHOLLS_DOXYGEN
# std::hash specialisations are documented in the std namespace
BUILTIN_STL_SUPPORT    = YES
# One comment documents a member group (///@{ ... ///@}), e.g. the ref-qualified
# overloads of result's members
DISTRIBUTE_GROUP_DOC   = YES
# Parser gaps (conditional explicit, digit separators): docs/doxygen_filter.py.
# FILTER_SOURCE_FILES stays NO, so the source browser shows the real code.
FILTER_PATTERNS        = "*.hpp=\"@Python3_EXECUTABLE@\" @CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen_filter.py"
